# Copy this file to .env and adjust as needed. Every value is optional —
# sensible defaults are used if unset (see src/utils/config.py).
#
# Relative paths below are resolved relative to the directory you RUN
# commands from — always run `python train.py` / `streamlit run app.py` /
# `uvicorn api:app` etc. from the project root.

# ---- Paths ---------------------------------------------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample
MODEL_DIR=models
REPORTS_DIR=reports
FIGURES_DIR=reports/figures
METRICS_DIR=reports/metrics
LOG_DIR=logs

# ---- Train / val / test split ---------------------------------------------
TEST_SIZE=0.15
VALIDATION_SIZE=0.15
RANDOM_STATE=42

# ---- TF-IDF ------------------------------------------------------------
MAX_FEATURES=20000
NGRAM_RANGE=1,2
MIN_DF=2
MAX_DF=0.95
SUBLINEAR_TF=true
STRIP_ACCENTS=unicode

# ---- Preprocessing ---------------------------------------------------------
USE_LEMMATIZATION=true
REMOVE_STOPWORDS=true
MAX_INPUT_CHARS=50000

# ---- Confidence bucketing --------------------------------------------------
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.65

# ---- Hyperparameter tuning --------------------------------------------------
ENABLE_TUNING=true
CV_FOLDS=5
TUNING_SEARCH_TYPE=grid
RANDOM_SEARCH_ITERATIONS=20

# ---- Logging / API ----------------------------------------------------------
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
